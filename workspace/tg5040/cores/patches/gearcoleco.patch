diff --git a/platforms/libretro/Makefile b/platforms/libretro/Makefile
index bed1e67..f715065 100644
--- a/platforms/libretro/Makefile
+++ b/platforms/libretro/Makefile
@@ -278,6 +278,23 @@ else ifeq ($(platform), miyoo)
 	SHARED := -shared -Wl,-version-script=$(CORE_DIR)/link.T
 	PLATFORM_DEFINES := -DCC_RESAMPLER -DCC_RESAMPLER_NO_HIGHPASS
 	PLATFORM_FLAGS += -fomit-frame-pointer -ffast-math -march=armv5te -mtune=arm926ej-s
+# TrimUI Brick/Smart Pro
+else ifeq ($(platform), tg5040)
+	TARGET := $(TARGET_NAME)_libretro.so
+	CC = $(CROSS_COMPILE)gcc
+	CXX = $(CROSS_COMPILE)g++
+	AR = $(CROSS_COMPILE)ar
+	fpic := -fPIC
+	SHARED := -shared -Wl,-version-script=$(CORE_DIR)/link.T
+	PLATFORM_DEFINES := -DCC_RESAMPLER -DCC_RESAMPLER_NO_HIGHPASS
+	PLATFORM_FLAGS += -Ofast \
+	-fuse-linker-plugin \
+	-fno-stack-protector -fno-ident -fomit-frame-pointer \
+	-fmerge-all-constants -ffast-math -funroll-all-loops \
+	-mtune=cortex-a53 -mcpu=cortex-a53 -march=armv8-a
+	HAVE_NEON = 1
+	USE_DYNAREC = 1
+	LDFLAGS += -mtune=cortex-a53 -mcpu=cortex-a53 -march=armv8-a -Ofast -flto -fuse-linker-plugin
 # PS2
 else ifeq ($(platform), ps2)
 	TARGET := $(TARGET_NAME)_libretro_$(platform).a
