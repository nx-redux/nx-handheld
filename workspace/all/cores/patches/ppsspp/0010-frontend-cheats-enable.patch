# Cheats set through retro_cheat_set never ran: PPSSPP's cheat engine only starts with
# bEnableCheats, which only the "Internal Cheats Support" option (off by default) set.
# Cheats the frontend sends now turn it on; retro_cheat_reset hands it back to the option.
diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
index 58dd53b..ae69ea8 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -112,6 +112,8 @@ static bool libretro_supports_bitmasks = false;
 static bool show_ip_address_options = true;
 static bool show_upnp_port_option = true;
 static bool show_detect_frame_rate_option = true;
+// Cheats the frontend sent through retro_cheat_set (its own cheat menu)
+static bool frontend_cheats = false;
 static std::string changeProAdhocServer;
 
 void* unserialize_data = NULL;
@@ -523,6 +525,18 @@ static void check_dynamic_variables(CoreParameter &coreParam) {
 
 extern int DefaultDepthRaster();
 
+// The cheat engine only runs with bEnableCheats, which "Internal Cheats Support"
+// (off by default) sets, so cheats the frontend sent never applied. Run them
+// whatever the option says; the option still turns the engine on by itself.
+static void update_cheats_enabled(void)
+{
+   struct retro_variable var = { "ppsspp_cheats", NULL };
+   bool option = false;
+   if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+      option = strcmp(var.value, "disabled") != 0;
+   g_Config.bEnableCheats = option || frontend_cheats;
+}
+
 static void check_variables(CoreParameter &coreParam)
 {
    check_dynamic_variables(coreParam);
@@ -652,14 +666,7 @@ static void check_variables(CoreParameter &coreParam)
          g_Config.bCacheFullIsoInRam = true;
    }
 
-   var.key = "ppsspp_cheats";
-   if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
-   {
-      if (!strcmp(var.value, "disabled"))
-         g_Config.bEnableCheats = false;
-      else
-         g_Config.bEnableCheats = true;
-   }
+   update_cheats_enabled();
 
    var.key = "ppsspp_psp_model";
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
@@ -1970,6 +1977,9 @@ size_t retro_get_memory_size(unsigned id)
 }
 
 void retro_cheat_reset(void) {
+   frontend_cheats = false;
+   update_cheats_enabled();
+
    // Init Cheat Engine
    CWCheatEngine cheatEngineObj(g_paramSFO.GetDiscID());
    CWCheatEngine *cheatEngine = &cheatEngineObj;
@@ -1993,6 +2003,11 @@ void retro_cheat_reset(void) {
 }
 
 void retro_cheat_set(unsigned index, bool enabled, const char *code) {
+   if (enabled) {
+      frontend_cheats = true;
+      update_cheats_enabled();
+   }
+
    // Initialize Cheat Engine
    CWCheatEngine cheatEngineObj(g_paramSFO.GetDiscID());
    CWCheatEngine *cheatEngine = &cheatEngineObj;
