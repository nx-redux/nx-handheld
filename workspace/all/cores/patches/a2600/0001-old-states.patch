+bool CartridgeE0::loadLegacy(Serializer& in)
+{
+  uint16_t slice[4];
+  in.getShortArray(slice, 4);
+  for(uint16_t seg = 0; seg < 3; ++seg)
+    bank(slice[seg] & 0x0007, seg);
+  return true;
+}
