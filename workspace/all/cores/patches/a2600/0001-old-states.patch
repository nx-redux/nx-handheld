# States from before the CartridgeEnhanced rework and the full TIA sound state (same "03090100state" header) load again:
# retro_unserialize retries a state the new layout rejects with the old cart (bank, RAM; E0 slices; 3E's 256+ RAM banks)
# and sound (six registers) fields. A state neither layout accepts leaves the running game as it was.
diff --git a/libretro.cxx b/libretro.cxx
index c1eebc5..c8db62c 100644
--- a/libretro.cxx
+++ b/libretro.cxx
@@ -1443,16 +1443,45 @@ bool retro_unserialize(const void *data, size_t size)
     * would otherwise escape across the C libretro ABI and abort the whole
     * process. This function is the firewall: any failure means "reject the
     * state", reported as a false return, never a crash. */
+   Serializer before;
+   bool have_before = false;
    try
    {
-      std::string s((const char*)data, size);
-      Serializer state;
-      state.set(s);
-      if(!stateManager.loadState(state))
-         return false;
+      have_before = stateManager.saveState(before);
    }
    catch(...)
    {
+   }
+
+   bool loaded = false;
+   for(int legacy = 0; legacy < 2 && !loaded; ++legacy)
+   {
+      try
+      {
+         std::string s((const char*)data, size);
+         Serializer state;
+         state.set(s);
+         state.setLegacy(legacy != 0);
+         loaded = stateManager.loadState(state);
+      }
+      catch(...)
+      {
+      }
+   }
+
+   if(!loaded)
+   {
+      if(have_before)
+      {
+         try
+         {
+            before.setPosition(0);
+            stateManager.loadState(before);
+         }
+         catch(...)
+         {
+         }
+      }
       return false;
    }
 
