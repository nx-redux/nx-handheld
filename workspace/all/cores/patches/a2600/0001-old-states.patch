@@ -293,6 +293,18 @@ bool Sound::load(Serializer& in)
    if(in.getString() != name())
       return false;
 
+   if(in.legacy())
+   {
+      uint8_t reg[6];
+      for(int i = 0; i < 6; ++i)
+         reg[i] = in.getByte();
+      myLastRegisterSetCycle = (int32_t) in.getInt();
+      myRegWriteQueue.clear();
+      for(int i = 0; i < 6; ++i)
+         myTIASound.set(0x15 + i, reg[i]);
+      return true;
+   }
+
    if(!myTIASound.load(in))
       return false;
 
