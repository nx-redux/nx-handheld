--- forkSrcPrefix/libretro/libretro.c
+++ forkDstPrefix/libretro/libretro.c
@@ -119,6 +119,19 @@
 static void (*video_post_process)(void) = NULL;
 static bool post_process_cc  = false;
 static bool post_process_mix = false;
+/* False when gba_screen_pixels_prev does not hold the previous frame (just
+ * allocated, mixing just turned on, a reset or a loaded state): the next mix
+ * blends the frame with itself instead of white or an unrelated frame */
+static bool post_process_prev_valid = false;
+
+static void video_post_process_seed_prev(void)
+{
+   if (!post_process_prev_valid)
+   {
+      memcpy(gba_screen_pixels_prev, gba_screen_pixels, GBA_SCREEN_BUFFER_SIZE);
+      post_process_prev_valid = true;
+   }
+}
 
 static void error_msg(const char* text)
 {
