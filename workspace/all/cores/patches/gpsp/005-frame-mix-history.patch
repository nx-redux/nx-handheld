    const size_t    npx      = GBA_SCREEN_HEIGHT * GBA_SCREEN_PITCH;
    size_t i;
 
+   video_post_process_seed_prev();
+
    for (i = 0; i < npx; i++)
    {
       uint16_t rgb_curr = src_curr[i];
@@ -292,6 +307,8 @@
