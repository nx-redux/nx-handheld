    rom_translation_cache = map_jit_block(ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE);
+  #ifdef JIT_STATIC_FALLBACK
+   if (!rom_translation_cache)
+   {
+      if (mprotect(jit_static_cache, sizeof(jit_static_cache),
+                   PROT_READ | PROT_WRITE | PROT_EXEC) == 0)
+      {
+         rom_translation_cache = jit_static_cache;
+         info_msg("Dynarec cache mapped inside the core image.");
+      }
+   }
+  #endif
