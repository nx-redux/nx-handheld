+    defined(ARM64_ARCH) && defined(__linux__)
+#include <sys/mman.h>
+/* Last-resort dynarec cache inside the core's own image (.bss), so it is
+ * always within direct-branch range of the core. Used when the frontend has
+ * already filled the address space around the core and map_jit_block fails.
+ * Untouched pages cost no memory. */
+#define JIT_STATIC_FALLBACK
+static u8 jit_static_cache[ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE]
+   __attribute__((aligned(65536)));
+#endif
