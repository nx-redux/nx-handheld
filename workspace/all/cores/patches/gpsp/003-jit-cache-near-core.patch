diff --git forkSrcPrefix/memmap.c forkDstPrefix/memmap.c
index b7b287d..7651746 100644
--- forkSrcPrefix/memmap.c
+++ forkDstPrefix/memmap.c
@@ -100,11 +100,82 @@ bool validate_addr_section_mips(void *ptr, unsigned size, unsigned max_offset_mb
 
 	#include <sys/mman.h>
 
+	#if defined(ARM64_ARCH) && defined(__linux__)
+	#include <stdio.h>
+	#include <unistd.h>
+
+	#define _MAP_RANGE      (128*1024*1024)   // Must match _VALIDATE_BLOCK_FN
+	#define _MAP_GAPS_MAX   64
+
+	// The probe loop below only passes hints; when the hinted address is taken
+	// the kernel puts the block somewhere far away and every probe fails once
+	// the frontend has mapped enough around the core. Instead read the free
+	// gaps from /proc/self/maps and hint an address inside the gap closest to
+	// the core: the range is free, so the kernel honours the hint.
+	static void *map_jit_block_in_gap(unsigned size) {
+		uintptr_t ref = (uintptr_t)(map_jit_block);
+		uintptr_t pgmask = (uintptr_t)sysconf(_SC_PAGESIZE) - 1;
+		uintptr_t len = ((uintptr_t)size + pgmask) & ~pgmask;
+		uintptr_t lo, hi, cand[_MAP_GAPS_MAX];
+		unsigned long ms, me, prev_end = 0;
+		unsigned n = 0, i;
+		FILE *f;
+
+		if (len >= _MAP_RANGE)
+			return NULL;
+		// Valid block starts: ref - range < start, start + size < ref + range.
+		lo = ref > _MAP_RANGE ? ((ref - _MAP_RANGE) | pgmask) + 1 : pgmask + 1;
+		hi = (ref + _MAP_RANGE - len - 1) & ~pgmask;
+
+		f = fopen("/proc/self/maps", "r");
+		if (!f)
+			return NULL;
+		while (n < _MAP_GAPS_MAX &&
+		       fscanf(f, "%lx-%lx%*[^\n]", &ms, &me) == 2) {
+			if (prev_end && ms > prev_end && ms - prev_end >= len) {
+				uintptr_t a = prev_end > lo ? prev_end : lo;
+				uintptr_t b = ms - len < hi ? ms - len : hi;
+				if (a <= b)
+					cand[n++] = ref < a ? a : ref > b ? b : (ref & ~pgmask);
+			}
+			if (me > prev_end)
+				prev_end = me;
+		}
+		fclose(f);
+
+		// Try the candidates closest to the core first.
+		while (n) {
+			unsigned best = 0;
+			void *p;
+			for (i = 1; i < n; i++) {
+				uintptr_t di = cand[i] > ref ? cand[i] - ref : ref - cand[i];
+				uintptr_t db = cand[best] > ref ? cand[best] - ref : ref - cand[best];
+				if (di < db)
+					best = i;
+			}
+			p = mmap((void*)cand[best], size, PROT_READ|PROT_WRITE|PROT_EXEC,
+			                                  MAP_ANON|MAP_PRIVATE, -1, 0);
+			if (p != MAP_FAILED) {
+				if (_VALIDATE_BLOCK_FN(p, size))
+					return p;
+				munmap(p, size);
+			}
+			cand[best] = cand[--n];
+		}
+		return NULL;
+	}
+	#endif
+
