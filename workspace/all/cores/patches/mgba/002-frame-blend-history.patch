+
+static void _seedFrameBlendHistory(void) {
+	size_t i;
+
+	if (frameBlendHistoryValid) {
+		return;
+	}
+	frameBlendHistoryValid = true;
+
+	switch (frameBlendType) {
+		case FRAME_BLEND_LCD_GHOSTING:
+			memcpy(outputBufferPrev4, outputBuffer, VIDEO_BUFF_SIZE);
+			/* fall through */
+		case FRAME_BLEND_MIX_SMART:
+			memcpy(outputBufferPrev3, outputBuffer, VIDEO_BUFF_SIZE);
+			memcpy(outputBufferPrev2, outputBuffer, VIDEO_BUFF_SIZE);
+			/* fall through */
+		case FRAME_BLEND_MIX:
+			memcpy(outputBufferPrev1, outputBuffer, VIDEO_BUFF_SIZE);
+			break;
+		case FRAME_BLEND_LCD_GHOSTING_FAST:
+			for (i = 0; i < (VIDEO_WIDTH_MAX * VIDEO_HEIGHT_MAX); i++) {
+				mColor rgb = outputBuffer[i];
+				outputBufferAccR[i] = (float)(rgb >> 11 & 0x1F);
+				outputBufferAccG[i] = (float)(rgb >>  6 & 0x1F);
+				outputBufferAccB[i] = (float)(rgb       & 0x1F);
+			}
+			break;
+		case FRAME_BLEND_NONE:
+		default:
+			break;
 	}
 }
 
