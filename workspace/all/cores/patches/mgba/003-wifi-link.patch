diff --git forkSrcPrefix/src/gba/sio/nx_wifi_link.c forkDstPrefix/src/gba/sio/nx_wifi_link.c
new file mode 100644
index 00000000..c1bb2c76
--- /dev/null
+++ forkDstPrefix/src/gba/sio/nx_wifi_link.c
@@ -0,0 +1,471 @@
+/* nx_wifi_link.c - gpSP's serial.c (write_siocnt, write_rcnt, update_serial)
+ * ported onto mGBA's GBASIODriver, driving gba_wifi_link: the GBA Wireless
+ * Adapter in Normal-32 mode, the Pokemon and Advance Wars cable protocols in
+ * Multi mode. The register handling and timings are gpSP's so the protocol
+ * code sees the same sequences it does on gpSP.
+ *
+ * gpSP's serial.c: Copyright (C) 2023 David Guillen Fandos <david@davidgf.net>
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#include <mgba/internal/gba/sio/nx_wifi_link.h>
+
+#include <mgba/internal/gba/gba.h>
+#include <mgba/internal/gba/io.h>
+#include <mgba/internal/gba/sio.h>
+
+#include <string.h>
+
+/* gpSP's transfer times (serial.c): a Normal-32 word to the adapter, and one
+ * Multi-mode message per player at each baud rate. */
+#define RFU_XFER_CYCLES_2MHZ (67 << 2)
+#define RFU_XFER_CYCLES_256KHZ (524 << 2)
+static const int32_t MULTI_MSG_CYCLES[4] = { 31457, 7864, 5242, 2621 };
+
+/* About as often as gpSP's main loop calls update_serial: at each of a
+ * scanline's two video events. The protocols push the adapter's words to the
+ * GBA and time their fake parent from these calls. */
+#define TICK_CYCLES (VIDEO_HORIZONTAL_LENGTH / 2)
+
+/* Longer than any packet gpSP sends (an Advance Wars packet is 520 bytes). */
+#define MAX_PACKET 1024
+
+static struct {
+	struct GBASIODriver d;
+	struct GBA* gba;
+	bool begun;    /* gwl_begin done: the netplay session is ours */
+	bool attached; /* our driver is on the serial port */
+	enum GwlMode mode;
+	uint16_t client_id;
+	int peers; /* connected peers, gpSP's netplay_num_clients */
+	void (*send)(uint16_t, const void*, size_t);
+	void (*poll)(void);
+	struct mTimingEvent tick;
+	uint32_t last; /* mTimingCurrentTime at the last gwl_update (wraps) */
+	enum GBASIOMode sioMode; /* to see Multi mode entered or left */
+	uint32_t rfuReply; /* the adapter's word for the transfer in flight */
+} wl;
+
+static bool _isCable(void) {
+	return wl.mode == GWL_POKE || wl.mode == GWL_AW1 || wl.mode == GWL_AW2;
+}
+
+static uint32_t _now(void) {
+	return (uint32_t) mTimingCurrentTime(&wl.gba->timing);
+}
+
+/* ---- GwlHost: gpSP's read_ioreg / write_ioreg / cpu_ticks / netpacket --- */
+
+static uint16_t _readIo(void* ctx, uint32_t off) {
+	UNUSED(ctx);
+	switch (off) {
+	case GBA_REG_SIOCNT:
+		return wl.gba->sio.siocnt;
+	case GBA_REG_RCNT:
+		return wl.gba->sio.rcnt;
+	default:
+		return wl.gba->memory.io[off >> 1];
+	}
+}
+
+static void _writeIo(void* ctx, uint32_t off, uint16_t v) {
+	UNUSED(ctx);
+	switch (off) {
+	case GBA_REG_SIOCNT:
+		wl.gba->sio.siocnt = v;
+		break;
+	case GBA_REG_RCNT:
+		wl.gba->sio.rcnt = v;
+		break;
+	default:
+		wl.gba->memory.io[off >> 1] = v;
+		break;
+	}
+}
+
+static uint32_t _cycles(void* ctx) {
+	UNUSED(ctx);
+	return _now();
+}
+
+static void _send(void* ctx, uint16_t client_id, const void* buf, size_t len) {
+	UNUSED(ctx);
+	if (wl.send) {
+		wl.send(client_id, buf, len);
+	}
+}
+
+static void _poll(void* ctx) {
+	UNUSED(ctx);
+	if (wl.poll) {
+		wl.poll();
+	}
+}
+
+/* ---- serial.c ---------------------------------------------------------- */
+
+/* gpSP's serial_mul_siocnt: every GBA ready, our id, parent or child. */
+static uint16_t _mulSiocnt(void) {
+	return 0x8 | ((wl.client_id & 3) << 4) | (wl.client_id ? 0x4 : 0);
+}
+
+/* The Multi-mode SI/SD/ID/error fields, for a game that reads SIOCNT
+ * without writing it first (attach, a savestate from before the session). */
+static void _refreshMultiBits(void) {
+	struct GBASIO* sio = &wl.gba->sio;
+	if (_isCable() && sio->mode == GBA_SIO_MULTI) {
+		sio->siocnt = (sio->siocnt & 0xFF83) | _mulSiocnt();
+		sio->rcnt = GBASIORegisterRCNTSetSi(sio->rcnt, !!wl.client_id);
+	}
+}
+
+static int32_t _multiCycles(uint16_t siocnt) {
+	return MULTI_MSG_CYCLES[siocnt & 3] * (wl.peers + 1);
+}
+
+static void _schedule(struct mTimingEvent* event, int32_t cycles) {
+	mTimingDeschedule(&wl.gba->timing, event);
+	mTimingSchedule(&wl.gba->timing, event, cycles);
+}
+
+/* update_serial's IRQ, when the protocol code says so. */
+static void _linkIrq(uint32_t cyclesLate) {
+	struct GBASIO* sio = &wl.gba->sio;
+	if (wl.mode == GWL_RFU) {
+		/* rfu_update already put the word in SIODATA32 and cleared Start. */
+		GBARaiseIRQ(wl.gba, GBA_IRQ_SIO, cyclesLate);
+	} else if (sio->mode == GBA_SIO_MULTI) {
+		/* A child: the fake parent's transfer ends with what the protocol
+		 * wrote to SIOMULTI0-3. Outside Multi mode a game expects no
+		 * transfer, so nothing is raised. */
+		uint16_t* io = wl.gba->memory.io;
+		uint16_t data[4] = { io[GBA_REG(SIOMULTI0)], io[GBA_REG(SIOMULTI1)], io[GBA_REG(SIOMULTI2)],
+		                     io[GBA_REG(SIOMULTI3)] };
+		GBASIOMultiplayerFinishTransfer(sio, data, cyclesLate);
+	}
+}
+
+static void _tickCallback(struct mTiming* timing, void* context, uint32_t cyclesLate) {
+	UNUSED(context);
+	uint32_t now = _now();
+	unsigned elapsed = now - wl.last;
+	wl.last = now;
+	bool irq = gwl_update(elapsed);
+	if (!wl.attached) {
+		return; /* the session ended inside the poll */
+	}
+	if (irq) {
+		_linkIrq(cyclesLate);
+	}
+	mTimingSchedule(timing, &wl.tick, TICK_CYCLES);
+}
+
+static void _rearmTick(void) {
+	wl.last = _now();
+	_schedule(&wl.tick, TICK_CYCLES);
+}
+
+/* ---- GBASIODriver ------------------------------------------------------ */
+
+static bool _driverInit(struct GBASIODriver* driver) {
+	UNUSED(driver);
+	return true;
+}
+
+/* Also when another driver replaces ours (a savestate of a GB Player game):
+ * from then on the serial port is not ours to touch. */
+static void _driverDeinit(struct GBASIODriver* driver) {
+	UNUSED(driver);
+	mTimingDeschedule(&wl.gba->timing, &wl.tick);
+	wl.attached = false;
+}
+
+/* GBAReset: it cleared the timing list (and global time) before calling us. */
+static void _driverReset(struct GBASIODriver* driver) {
+	UNUSED(driver);
+	_rearmTick();
+}
+
+static bool _driverHandlesMode(struct GBASIODriver* driver, enum GBASIOMode mode) {
+	UNUSED(driver);
+	return wl.mode == GWL_RFU ? mode == GBA_SIO_NORMAL_32 : mode == GBA_SIO_MULTI;
+}
+
+static void _driverSetMode(struct GBASIODriver* driver, enum GBASIOMode mode) {
+	UNUSED(driver);
+	if (_isCable() && (wl.sioMode == GBA_SIO_MULTI) != (mode == GBA_SIO_MULTI)) {
+		gwl_reset_proto();
+	}
+	wl.sioMode = mode;
+}
+
+/* GBASIOTransferCycles takes at most 3 others; the adapter is no cable. */
+static int _driverConnectedDevices(struct GBASIODriver* driver) {
+	UNUSED(driver);
+	if (!_isCable()) {
+		return 0;
+	}
+	return wl.peers < MAX_GBAS - 1 ? wl.peers : MAX_GBAS - 1;
+}
+
+static int _driverDeviceId(struct GBASIODriver* driver) {
+	UNUSED(driver);
+	return _isCable() ? wl.client_id & 3 : 0;
+}
+
+/* write_rcnt. Called in every mode, with the old low RCNT bits still in
+ * sio->rcnt; the value returned is stored as without a driver. */
+static uint16_t _driverWriteRCNT(struct GBASIODriver* driver, uint16_t value) {
+	struct GBASIO* sio = driver->p;
+	switch (sio->mode) {
+	case GBA_SIO_GPIO:
+		/* Pulling PD high resets the adapter. */
+		if (wl.mode == GWL_RFU && (value & 0x20) && !(sio->rcnt & 0x02)) {
+			gwl_reset_rfu();
+		}
+		break;
+	case GBA_SIO_MULTI:
+		if (_isCable()) {
+			sio->siocnt = (sio->siocnt & 0xFF83) | _mulSiocnt();
+		}
+		break;
+	default:
+		break;
+	}
+	return value;
+}
+
+/* write_siocnt. GBASIOWriteSIOCNT calls this after its own handling (and
+ * after start()), with sio->siocnt still the old value. */
+static uint16_t _driverWriteSIOCNT(struct GBASIODriver* driver, uint16_t value) {
+	struct GBASIO* sio = driver->p;
+	uint16_t old = sio->siocnt;
+	if (sio->mode == GBA_SIO_MULTI) {
+		/* mGBA keeps Busy latched until the transfer ends; the rest of
+		 * the status fields are gpSP's. */
+		uint16_t v = (value & 0xFF83) | _mulSiocnt();
+		if (!wl.client_id && GBASIOMultiplayerIsBusy(v) && !GBASIOMultiplayerIsBusy(old) &&
+		    mTimingIsScheduled(&wl.gba->timing, &sio->completeEvent)) {
+			/* start() sent it; gpSP's duration, from the baud written now. */
+			_schedule(&sio->completeEvent, _multiCycles(v));
+		}
+		return v;
+	}
+
+	/* Normal-32 with the adapter. */
+	uint16_t v = (value & 0x7F8B) | (old & 0x0004);
+	/* gpSP starts on the Start bit's level, not its edge: a game that flips
+	 * the clock to internal with Start already set sends then. */
+	if (GBASIONormalIsStart(v) && GBASIONormalIsSc(v) && !mTimingIsScheduled(&wl.gba->timing, &sio->completeEvent)) {
+		uint16_t* io = wl.gba->memory.io;
+		wl.rfuReply = gwl_rfu_transfer((uint32_t) io[GBA_REG(SIODATA32_LO)] | ((uint32_t) io[GBA_REG(SIODATA32_HI)] << 16));
+		_schedule(&sio->completeEvent, GBASIONormalIsInternalSc(v) ? RFU_XFER_CYCLES_2MHZ : RFU_XFER_CYCLES_256KHZ);
+	}
+	/* The adapter's SI/SO acknowledge. */
+	bool soRise = GBASIONormalIsIdleSo(v) && !GBASIONormalIsIdleSo(old);
+	bool soFall = !GBASIONormalIsIdleSo(v) && GBASIONormalIsIdleSo(old);
+	if (GBASIONormalIsSc(v)) {
+		/* Parent: the GBA going busy lets the adapter show ready. */
+		if (soRise) {
+			v = GBASIONormalClearSi(v);
+		}
+	} else {
+		/* Child: SI follows SO, the adapter busy while the GBA is. */
+		if (soRise) {
+			v = GBASIONormalFillSi(v);
+		}
+		if (soFall) {
+			v = GBASIONormalClearSi(v);
+		}
+	}
+	return v;
+}
+
+/* _startTransfer: true = mGBA schedules completeEvent, which calls finish*. */
+static bool _driverStart(struct GBASIODriver* driver) {
+	struct GBASIO* sio = driver->p;
+	if (!_driverHandlesMode(driver, sio->mode)) {
+		return true; /* as without a driver */
+	}
+	if (sio->mode == GBA_SIO_MULTI) {
+		/* Only the parent gets here (sio.c). */
+		gwl_multi_master_send();
+		return true;
+	}
+	/* Normal-32: the clock source is in the value being written, so
+	 * _driverWriteSIOCNT starts the transfer. */
+	return false;
+}
+
+static void _driverFinishMultiplayer(struct GBASIODriver* driver, uint16_t data[4]) {
+	if (!_driverHandlesMode(driver, GBA_SIO_MULTI)) {
+		return;
+	}
+	/* What the protocol wrote at the start; gpSP keeps it as the result. */
+	uint16_t* io = driver->p->p->memory.io;
+	data[0] = io[GBA_REG(SIOMULTI0)];
+	data[1] = io[GBA_REG(SIOMULTI1)];
+	data[2] = io[GBA_REG(SIOMULTI2)];
+	data[3] = io[GBA_REG(SIOMULTI3)];
+}
+
+static uint32_t _driverFinishNormal32(struct GBASIODriver* driver) {
+	if (!_driverHandlesMode(driver, GBA_SIO_NORMAL_32)) {
+		return 0;
+	}
+	/* gpSP ends the word with SI high: the adapter's busy for the handshake. */
+	driver->p->siocnt = GBASIONormalFillSi(driver->p->siocnt);
+	return wl.rfuReply;
+}
+
+/* ---- frontend side ----------------------------------------------------- */
+
+static void _resetLink(void) {
+	if (wl.mode == GWL_RFU) {
+		gwl_reset_rfu();
+	} else {
+		gwl_reset_proto();
+	}
+}
+
+void nx_wifi_link_attach(struct GBA* gba, enum GwlMode mode, uint16_t client_id,
+                         void (*send)(uint16_t, const void*, size_t), void (*poll)(void)) {
+	if (wl.begun) {
+		nx_wifi_link_detach(wl.gba);
+	}
+	wl.gba = gba;
+	wl.send = send;
+	wl.poll = poll;
+	wl.peers = 0;
+	wl.client_id = client_id;
+
+	GwlHost host = { NULL, _readIo, _writeIo, _cycles, _send, _poll };
+	gwl_begin(&host, mode, client_id);
+	wl.begun = true;
+	/* GWL_NONE when the mode has no slot for our id: the port stays stock. */
+	wl.mode = gwl_mode();
+	if (wl.mode == GWL_NONE) {
+		return;
+	}
+	/* A previous session's adapter or protocol state means nothing now. */
+	_resetLink();
+
+	memset(&wl.d, 0, sizeof(wl.d));
+	wl.d.init = _driverInit;
+	wl.d.deinit = _driverDeinit;
+	wl.d.reset = _driverReset;
+	wl.d.setMode = _driverSetMode;
+	wl.d.handlesMode = _driverHandlesMode;
+	wl.d.connectedDevices = _driverConnectedDevices;
+	wl.d.deviceId = _driverDeviceId;
+	wl.d.writeRCNT = _driverWriteRCNT;
+	wl.d.writeSIOCNT = _driverWriteSIOCNT;
+	wl.d.start = _driverStart;
+	wl.d.finishMultiplayer = _driverFinishMultiplayer;
+	wl.d.finishNormal32 = _driverFinishNormal32;
+
+	wl.tick.context = NULL;
+	wl.tick.name = "NX Wi-Fi link";
+	wl.tick.callback = _tickCallback;
+	wl.tick.priority = 0x81;
+
+	wl.sioMode = gba->sio.mode;
+	GBASIOSetDriver(&gba->sio, &wl.d);
+	wl.attached = gba->sio.driver == &wl.d;
+	if (wl.attached) {
+		_refreshMultiBits();
+		_rearmTick();
+	}
+}
+
+void nx_wifi_link_detach(struct GBA* gba) {
+	if (!wl.begun) {
+		return;
+	}
+	gwl_end();
+	wl.begun = false;
+	wl.send = NULL;
+	wl.poll = NULL;
+	if (wl.attached) {
+		wl.attached = false;
+		if (gba && gba->sio.driver == &wl.d) {
+			GBASIOSetDriver(&gba->sio, NULL);
+		}
+	}
+}
+
+bool nx_wifi_link_connected(uint16_t client_id) {
+	if (!wl.begun || !gwl_connected(client_id)) {
+		return false;
+	}
+	wl.peers++;
+	return true;
+}
+
+void nx_wifi_link_disconnected(uint16_t client_id) {
+	if (!wl.begun) {
+		return;
+	}
+	gwl_disconnected(client_id);
+	if (wl.peers > 0) {
+		wl.peers--;
+	}
+}
+
+void nx_wifi_link_receive(const void* buf, size_t len, uint16_t client_id) {
+	if (!wl.begun) {
+		return;
+	}
+	/* gpSP's protocol code reads packets as 32-bit words. */
+	if (((uintptr_t) buf & 3) == 0) {
+		gwl_receive(buf, len, client_id);
+		return;
+	}
+	uint32_t aligned[MAX_PACKET / 4];
+	if (len > sizeof(aligned)) {
+		return;
+	}
+	memcpy(aligned, buf, len);
+	gwl_receive(aligned, len, client_id);
+}
+
+void nx_wifi_link_frame_update(void) {
+	if (wl.begun) {
+		gwl_frame_update();
+	}
+}
+
+/* A savestate restores mGBA's timing (global time, event list) but neither
+ * our tick nor the link, and the peers did not load it: the adapter or
+ * protocol starts over, as on a replug. mGBA restores sio.completeEvent when
+ * the state had Start/Busy set, so a transfer caught in flight still ends,
+ * but the adapter's reply to it was not saved: it ends with nothing on the
+ * line. A completion restored for a transfer we don't time (the adapter's
+ * push to a child GBA, a cable child) is dropped, as those end from the
+ * tick. States without the event get one for a parent's transfer, rather
+ * than leaving the game's Busy/Start bit stuck. */
+void nx_wifi_link_state_loaded(void) {
+	if (!wl.attached) {
+		return;
+	}
+	struct GBASIO* sio = &wl.gba->sio;
+	struct mTiming* timing = &wl.gba->timing;
+	_resetLink();
+	wl.sioMode = sio->mode;
+	if (wl.mode == GWL_RFU) {
+		wl.rfuReply = 0xFFFFFFFFu;
+	}
+	bool rfuParent = wl.mode == GWL_RFU && sio->mode == GBA_SIO_NORMAL_32 && GBASIONormalIsStart(sio->siocnt) &&
+	                 GBASIONormalIsSc(sio->siocnt);
+	bool multiParent = _isCable() && sio->mode == GBA_SIO_MULTI && !wl.client_id && GBASIOMultiplayerIsBusy(sio->siocnt);
+	if (!rfuParent && !multiParent) {
+		/* In a mode we don't handle, mGBA's stock code times the transfer:
+		 * cancelling its event would leave Start set for good. */
+		if (_driverHandlesMode(&wl.d, sio->mode)) {
+			mTimingDeschedule(timing, &sio->completeEvent);
+		}
+	} else if (!mTimingIsScheduled(timing, &sio->completeEvent)) {
+		_schedule(&sio->completeEvent, rfuParent ? (GBASIONormalIsInternalSc(sio->siocnt) ? RFU_XFER_CYCLES_2MHZ : RFU_XFER_CYCLES_256KHZ)
+		                                         : _multiCycles(sio->siocnt));
+	}
+	_refreshMultiBits();
+	_rearmTick();
+}
