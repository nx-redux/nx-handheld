diff --git forkSrcPrefix/include/mgba/internal/gba/sio/nx_wifi_link.h forkDstPrefix/include/mgba/internal/gba/sio/nx_wifi_link.h
new file mode 100644
index 00000000..582cb1de
--- /dev/null
+++ forkDstPrefix/include/mgba/internal/gba/sio/nx_wifi_link.h
@@ -0,0 +1,37 @@
+/* nx_wifi_link.h - gpSP's GBA Wireless Adapter and link-cable protocol
+ * emulation (Pokemon, Advance Wars) on mGBA's serial port, over libretro
+ * netpacket, wire-compatible with gpSP netplay.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef GBA_SIO_NX_WIFI_LINK_H
+#define GBA_SIO_NX_WIFI_LINK_H
+
+#include <mgba-util/common.h>
+
+CXX_GUARD_START
+
+#include "gwl.h"
+
+/* The protocols live in gba_wifi_link (NX_GWL_DIR, shared with the Brick and
+ * phone frontends); this driver is gpSP's serial.c glue on mGBA's
+ * GBASIODriver. One link per process, like gba_wifi_link itself. */
+
+struct GBA;
+
+/* Netplay session up: the device for mode goes on the serial port. send gets
+ * the netplay client id to send to (0xFFFF: everyone). */
+void nx_wifi_link_attach(struct GBA* gba, enum GwlMode mode, uint16_t client_id,
+                         void (*send)(uint16_t client_id, const void* buf, size_t len), void (*poll)(void));
+/* Session over: the driver is removed and the serial port is stock again. */
+void nx_wifi_link_detach(struct GBA* gba);
+/* false: refuse the peer (more than the mode has slots for). */
+bool nx_wifi_link_connected(uint16_t client_id);
+void nx_wifi_link_disconnected(uint16_t client_id);
+void nx_wifi_link_receive(const void* buf, size_t len, uint16_t client_id);
+/* Once per retro_run. */
+void nx_wifi_link_frame_update(void);
+/* After a savestate load (retro_unserialize). */
+void nx_wifi_link_state_loaded(void);
+
+CXX_GUARD_END
+
+#endif
